{
  "name": "RivhitRawDocument",
  "type": "object",
  "properties": {
    "rivhit_document_id": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e1\u05de\u05da \u2014 \u05d4\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d9 \u05de\u05e8\u05d9\u05d5\u05d5\u05d7\u05d9\u05ea"
    },
    "document_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e1\u05de\u05da \u05de\u05dc\u05d0 \u05db\u05d5\u05dc\u05dc \u05e1\u05d3\u05e8\u05d4 (\u05dc\u05d3\u05d5\u05d2\u05de\u05d4: 01/004637)"
    },
    "document_type": {
      "type": "number",
      "description": "\u05e1\u05d5\u05d2 \u05de\u05e1\u05de\u05da"
    },
    "document_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05e1\u05de\u05da"
    },
    "rivhit_card_number": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05db\u05e8\u05d8\u05d9\u05e1 \u05dc\u05e7\u05d5\u05d7 (\u05dc\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05dc\u05e7\u05d5\u05d7)"
    },
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05dc\u05e7\u05d5\u05d7 \u05db\u05e4\u05d9 \u05e9\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05de\u05e1\u05de\u05da"
    },
    "total_before_vat": {
      "type": "number",
      "description": "\u05e1\u05d4\"\u05db \u05dc\u05dc\u05d0 \u05de\u05e2\"\u05de"
    },
    "discount_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05e0\u05d7\u05d4"
    },
    "vat_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05de\u05e2\"\u05de"
    },
    "total_to_pay": {
      "type": "number",
      "description": "\u05e1\u05d4\"\u05db \u05dc\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "lines": {
      "type": "object",
      "description": "\u05e9\u05d5\u05e8\u05d5\u05ea \u05d4\u05de\u05e1\u05de\u05da \u05db-JSON (\u05e7\u05d5\u05d3 \u05e4\u05e8\u05d9\u05d8, \u05ea\u05d9\u05d0\u05d5\u05e8, \u05db\u05de\u05d5\u05ea, \u05de\u05d7\u05d9\u05e8, \u05e1\u05d4\"\u05db)"
    },
    "raw_json": {
      "type": "object",
      "description": "JSON \u05d2\u05d5\u05dc\u05de\u05d9 \u05de\u05dc\u05d0 \u05de\u05e8\u05d9\u05d5\u05d5\u05d7\u05d9\u05ea"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "success",
        "error"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e1\u05e0\u05db\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "rivhit_document_id"
  ]
}