{
  "name": "SyncLog",
  "type": "object",
  "properties": {
    "sync_type": {
      "type": "string",
      "enum": [
        "customers",
        "products",
        "documents",
        "full"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "error"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df"
    },
    "records_fetched": {
      "type": "number",
      "description": "\u05db\u05de\u05d4 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05d4\u05ea\u05e7\u05d1\u05dc\u05d5 \u05de\u05e8\u05d9\u05d5\u05d5\u05d7\u05d9\u05ea"
    },
    "records_saved": {
      "type": "number",
      "description": "\u05db\u05de\u05d4 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05e0\u05e9\u05de\u05e8\u05d5 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4"
    },
    "error_message": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05ea \u05e9\u05d2\u05d9\u05d0\u05d4 \u05d0\u05dd \u05d9\u05e9"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e1\u05d9\u05d5\u05dd \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df"
    }
  },
  "required": []
}