{
  "name": "SupplierOrder",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e4\u05e7"
    },
    "supplier_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05e4\u05e7"
    },
    "item_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d9\u05d8"
    },
    "quantity": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea"
    },
    "unit": {
      "type": "string",
      "enum": [
        "\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea",
        "\u05dc\u05d9\u05d8\u05e8",
        "\u05e7\"\u05d2",
        "\u05e7\u05e8\u05d8\u05d5\u05df",
        "\u05de\"\u05dc"
      ],
      "default": "\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea",
      "description": "\u05d9\u05d7\u05d9\u05d3\u05d4"
    },
    "price_per_unit": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05dc\u05d9\u05d7\u05d9\u05d3\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05d8\u05d9\u05d5\u05d8\u05d4",
        "\u05e0\u05e9\u05dc\u05d7",
        "\u05d4\u05ea\u05e7\u05d1\u05dc"
      ],
      "default": "\u05d8\u05d9\u05d5\u05d8\u05d4",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "order_group": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05d6\u05de\u05e0\u05d4 (UUID)"
    }
  },
  "required": [
    "item_name"
  ]
}